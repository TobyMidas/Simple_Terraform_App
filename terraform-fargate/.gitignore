#local terraform directory
**/.terraform/*

#tfstate files
*.tfstate
*.tfstate.*

#Crash log files
crash.log
crash.log.*

#Exclude tvars files
*.tfvars
*.tfvars.json
*.tfvars
!dev.tfvars
!prod.tfvars

#Ignore override files as they are usually used to override resources locally and so shouldn't be versioned
override.tf
override.tf.json
*_override.tf
*_override.tf.json

#Ignore CLI configuration files
.terraformrc
terraform.rc